{
    "name": "sgoranov/oauth2-openid-connect-server",
    "description": "An OpenID Connect Server built on The PHP League's OAuth2 Server",
    "license": "MIT",
    "authors": [
        {
            "name": "Goranov",
            "email": "sgoranov@users.noreply.github.com",
            "role": "Maintainer"
        },
        {
            "name": "Steve Rhoades",
            "email": "sedonami@gmail.com",
            "role": "Original author"
        }
    ],
    "require": {
        "php": "^8.2",
        "league/oauth2-server": "^9.0",
        "lcobucci/jwt": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "laminas/laminas-diactoros": "^1.3.2 || ^3.3"
    },
    "conflict": {
        "steverhoades/oauth2-openid-connect-server": "*"
    },
    "autoload": {
        "psr-4": {
            "OpenIDConnectServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenIDConnectServer\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
